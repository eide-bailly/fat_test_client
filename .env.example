# example.env — copy to .env and fill in real values before running any commands.
#
# NEVER commit .env to source control. It must be listed in .gitignore.
# This file (example.env) contains only placeholder values and IS safe to commit.
#
# How secrets are loaded:
#   Set UV_ENV_FILE=.env in .claude/settings.json so every `uv run` call
#   in the session loads .env automatically — no manual `source` required.
#   See exemplars/claude-settings.json for the recommended .claude/settings.json.

# ---------------------------------------------------------------------------
# Service principal credentials (canonical names — each value appears once)
# Create an app registration in Entra ID (Azure AD) and grant it the required
# Fabric workspace roles. Store the secret in Azure Key Vault for production;
# use .env only for local development.
#
# The client secret carries the DBT_ENV_SECRET prefix so that dbt scrubs it
# from logs and console output. It is still the single canonical SP secret —
# do not create a second unprefixed copy.
#
# Tools expect different names and the skills map them at invocation time:
#   fab CLI       → FABRIC_CLIENT_ID / FABRIC_CLIENT_SECRET / FABRIC_TENANT_ID
#                   (see provision-fabric skill, Service Principal Auth)
#   fabric-cicd   → AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID
#                   (see the cicd-azure-devops component exemplar)
#   dbt           → reads these names directly in profiles.yml; no mapping
# ---------------------------------------------------------------------------
SERVICE_PRINCIPAL_CLIENT_ID=<your-sp-client-id>
SERVICE_PRINCIPAL_TENANT_ID=<your-tenant-id>
DBT_ENV_SECRET_SERVICE_PRINCIPAL_CLIENT_SECRET=<your-sp-client-secret>

# ---------------------------------------------------------------------------
# Fabric workspace and capacity
# Find these GUIDs in the Fabric portal URL or via `fab workspace list`.
# These are IDs, not secrets — but keep them out of source control anyway
# to avoid leaking environment topology.
# ---------------------------------------------------------------------------
FABRIC_WORKSPACE_ID=<your-workspace-id>
FABRIC_CAPACITY_ID=<your-capacity-id>

# ---------------------------------------------------------------------------
# Fabric data workspace (split-workspace pattern)
# In split mode, Fabric items (pipelines, notebooks, dbt jobs) live in the
# items workspace; lakehouses and warehouses live in the data workspace.
# If using a single workspace, set FABRIC_DATA_WORKSPACE_ID=FABRIC_WORKSPACE_ID.
# ---------------------------------------------------------------------------
FABRIC_DATA_WORKSPACE_ID=<your-data-workspace-id>

# ---------------------------------------------------------------------------
# dbt (required when the dbt-framework component is composed; delete otherwise)
# Read by dbt/profiles.yml via env_var(). Identity comes from the canonical
# SERVICE_PRINCIPAL_* values above — only the warehouse connection settings
# are dbt-specific. DBT_FABRIC_SERVER is the Fabric Warehouse TDS endpoint
# (Settings → SQL connection string in the Fabric portal).
#
# DBT_PROJECT_DIR and DBT_PROFILES_DIR are native dbt env vars. With
# UV_ENV_FILE=.env set, every `uv run dbt` command picks up these paths
# automatically — no --project-dir or --profiles-dir flags needed.
# ---------------------------------------------------------------------------
DBT_FABRIC_SERVER=<your-warehouse-tds-endpoint>
DBT_FABRIC_WAREHOUSE=<your-warehouse-name>
#
# Per-environment endpoint overrides. DBT_FABRIC_SERVER alone is enough when
# every environment's warehouse lives behind the same TDS endpoint (e.g. a
# single-workspace engagement, or local dev only ever targeting dev). Add the
# per-environment variables below when dev and prod are genuinely separate
# Fabric warehouses with different connection strings — e.g. profiles.yml (or
# the CI pipeline) needs to pick the right endpoint per target environment.
DBT_FABRIC_SERVER_DEV=<dev-warehouse-tds-endpoint>
DBT_FABRIC_SERVER_PROD=<prod-warehouse-tds-endpoint>
DBT_PROJECT_DIR=fabric/elt/core/dbt_build.DataBuildToolJob/Code/dbt
DBT_PROFILES_DIR=fabric/elt/core/dbt_build.DataBuildToolJob/Code/dbt

# ---------------------------------------------------------------------------
# uv environment file loader
# With UV_ENV_FILE set here, `uv run` will load this file automatically.
# Alternatively, set it in .claude/settings.json under "env" for Claude Code
# sessions, or export it from your shell profile for terminal sessions.
# ---------------------------------------------------------------------------
UV_ENV_FILE=.env
